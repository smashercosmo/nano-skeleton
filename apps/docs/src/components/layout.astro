---
// oxlint-disable-next-line import/no-unassigned-import -- global theme styles
import "microlighter/themes/github.css";
// oxlint-disable-next-line import/no-unassigned-import -- global styles
import "#root/styles/global.css";

import Header from "#components/header.astro";
import { withBase } from "#root/site.js";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(withBase("icon-512.png"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("icon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("manifest.webmanifest")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
  </head>
  <body data-syntax-theme="github">
    <Header />
    <slot />
    <footer class="footer">MIT © Vladislav Shkodin</footer>
    <script>
      // oxlint-disable-next-line import/no-unassigned-import -- entry point
      import "#root/scripts/main.js";
    </script>
  </body>
</html>

<style>
  .footer {
    padding: 2rem 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }
</style>
