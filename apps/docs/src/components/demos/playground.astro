---
import DemoFrame from "#components/demo-frame.astro";
import { withBase } from "#root/site.js";
---

<DemoFrame label="Playground" class="playground">
  <div class="pg">
    <form class="pg__controls" data-pg-form>
      <fieldset>
        <legend>Text</legend>
        <label>
          Font size <output name="fontSizeOut">16px</output>
          <input type="range" name="fontSize" min="12" max="32" value="16" />
        </label>
        <label>
          Inline style
          <select name="inlineStyle">
            <option value="lines-bg-per-line">lines-bg-per-line (default)</option>
            <option value="lines-bg-per-block">lines-bg-per-block</option>
            <option value="words-bg-per-line">words-bg-per-line</option>
            <option value="words-bg-per-block">words-bg-per-block</option>
          </select>
        </label>
        <label>
          Inline border radius <output name="inlineRadiusOut">1</output>
          <input
            type="range"
            name="inlineRadius"
            min="0"
            max="1"
            step="0.05"
            value="1"
          />
        </label>
        <label>
          Letter spacing <output name="letterSpacingOut">0em</output>
          <input
            type="range"
            name="letterSpacing"
            min="-0.1"
            max="0.2"
            step="0.01"
            value="0"
          />
        </label>
        <label>
          Container width <output name="widthOut">480px</output>
          <input
            type="range"
            name="width"
            min="220"
            max="640"
            step="10"
            value="480"
          />
        </label>
      </fieldset>

      <fieldset>
        <legend>Elements</legend>
        <label>
          Avatar border radius <output name="avatarRadiusOut">50%</output>
          <input type="range" name="avatarRadius" min="0" max="50" value="50" />
        </label>
        <div class="pg__row" role="radiogroup" aria-label="Link mode">
          <span>Link mode</span>
          <label><input type="radio" name="linkMode" value="auto" /> auto</label>
          <label
            ><input type="radio" name="linkMode" value="inline" checked /> inline</label
          >
        </div>
        <label class="pg__check">
          <input type="checkbox" name="interactive" /> Interactive link
        </label>
        <div class="pg__row" role="radiogroup" aria-label="Direction">
          <span>Direction</span>
          <label><input type="radio" name="dir" value="ltr" checked /> LTR</label>
          <label><input type="radio" name="dir" value="rtl" /> RTL</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Animation</legend>
        <div class="pg__row" role="radiogroup" aria-label="Animation">
          <label
            ><input type="radio" name="animation" value="nano-skeleton-shimmer" checked /> shimmer</label
          >
          <label><input type="radio" name="animation" value="pulse" /> pulse</label>
          <label><input type="radio" name="animation" value="none" /> none</label>
        </div>
        <label>
          Duration <output name="durationOut">2s</output>
          <input
            type="range"
            name="duration"
            min="0.5"
            max="5"
            step="0.1"
            value="2"
          />
        </label>
        <label>
          Background size <output name="bgSizeOut">300%</output>
          <input
            type="range"
            name="bgSize"
            min="100"
            max="600"
            step="25"
            value="300"
          />
        </label>
        <label>
          Colors
          <select name="colors">
            <option value="default">Default</option>
            <option value="indigo">Indigo</option>
            <option value="emerald">Emerald</option>
            <option value="amber">Amber</option>
            <option value="rose">Rose</option>
          </select>
        </label>
      </fieldset>
    </form>

    <div class="pg__preview">
      <nano-skeleton-provider class="pg__card" data-pg-card>
        <article>
          <div class="pg__head">
            <nano-skeleton>
              <img
                class="pg__avatar"
                src={withBase("cover.svg")}
                width="64"
                height="64"
                alt=""
              />
            </nano-skeleton>
            <div class="pg__who">
              <h3><nano-skeleton data-pg-text>Jane Cooper</nano-skeleton></h3>
              <p class="pg__role">
                <nano-skeleton data-pg-text>
                  Senior product designer
                </nano-skeleton>
              </p>
            </div>
          </div>
          <p>
            <nano-skeleton data-pg-text>
              Designs calm, accessible interfaces and writes about the small
              details that make loading states feel fast.
            </nano-skeleton>
          </p>
          <div class="pg__actions">
            <nano-skeleton inline="" data-pg-link
              ><a href="#playground">View profile</a></nano-skeleton
            >
            <nano-skeleton><button type="button" class="button">Follow</button></nano-skeleton>
          </div>
        </article>
      </nano-skeleton-provider>
    </div>
  </div>

  <div class="pg__code">
    <pre><code class="language-html" data-pg-html></code></pre>
    <pre><code class="language-css" data-pg-css></code></pre>
  </div>
</DemoFrame>

<script>
  import { initPlayground } from "#root/scripts/playground.js";

  initPlayground();
</script>

<style>
  .pg {
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 48rem) {
    .pg {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .pg__controls {
    display: grid;
    gap: 1rem;
    font-size: 0.85rem;
  }

  fieldset {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    margin-bottom: 0.4rem;
    padding: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  fieldset > label {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem;
  }

  fieldset > label > :is(input[type="range"], select) {
    grid-column: 1 / -1;
    width: 100%;
  }

  output {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  .pg__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .pg__row > span {
    flex-basis: 100%;
  }

  fieldset > .pg__check {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pg__preview {
    display: grid;
    place-items: start center;
    padding: 1rem;
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .pg__card {
    --pg-font-size: 16px;
    --pg-width: 480px;
    --pg-avatar-radius: 50%;
    display: block;
    width: min(100%, var(--pg-width));
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    font-size: var(--pg-font-size);
  }

  .pg__head {
    display: flex;
    align-items: center;
    gap: 0.9em;
  }

  .pg__avatar {
    display: block;
    width: 4em;
    height: 4em;
    border-radius: var(--pg-avatar-radius);
    object-fit: cover;
  }

  .pg__who {
    min-width: 0;
  }

  h3 {
    margin: 0;
    font-size: 1.2em;
  }

  p {
    margin: 0.75em 0 0;
  }

  .pg__role {
    margin: 0.15em 0 0;
    color: var(--muted);
    font-size: 0.85em;
  }

  .pg__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75em;
    margin-top: 1em;
  }

  .pg__code {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0 1rem;
    margin-top: 1rem;
  }

  /* The wrapper with the copy button is added by the client script */
  .pg__code :global(.code-block) {
    margin: 0.5rem 0 0;
  }

  .pg__code pre {
    margin: 0;
    font-size: 0.8rem;
  }
</style>
