---
import ThemeSwitcher from "#components/theme-switcher.astro";
import {
  LOGO_REVEALED_KEY,
  NPM_URL,
  REPO_URL,
  VERSION,
  withBase,
} from "#root/site.js";

const DOCS_URL = withBase();
const CHANGELOG_URL = withBase("changelog/");
const { pathname } = Astro.url;
---

<header class="header">
  <a class="logo" href={DOCS_URL} aria-label="nano-skeleton, home">
    {
      /**
       * The logo's skeleton is decoration: it's "loading" forever. An explicit
       * aria-busy wins over the one the provider sets, so screen readers
       * aren't told that the link is still updating
       */
    }
    <span class="logo__text"
      ><span>nano</span><nano-skeleton-provider loading aria-busy="false"
        ><nano-skeleton inline="words-bg-per-line" class="logo__word">skeleton</nano-skeleton
        ></nano-skeleton-provider
      ></span
    >
    {
      /**
       * The real text, invisible, in the same grid cell: the logo is as wide
       * as the revealed word in any font, so the badge doesn't move
       */
    }
    <span class="logo__sizer" aria-hidden="true"
      >nano<span class="logo__word">skeleton</span></span
    >
  </a>
  {
    /**
     * Once revealed, the logo stays revealed on the next pages too. Runs
     * before the first paint, so a revealed logo doesn't flash as a skeleton
     */
  }
  <script is:inline data-key={LOGO_REVEALED_KEY}>
    try {
      const key = document.currentScript?.dataset.key;
      if (key && sessionStorage.getItem(key)) {
        document
          .querySelector(".logo nano-skeleton-provider")
          ?.removeAttribute("loading");
      }
    } catch {
      // Storage is unavailable, e.g. blocked: the logo starts as a skeleton
    }
  </script>
  <a class="badge" href={CHANGELOG_URL} title="Changelog">v{VERSION}</a>
  <nav class="nav" aria-label="Main">
    <a href={DOCS_URL} aria-current={pathname === DOCS_URL ? "page" : undefined}
      >Docs</a
    >
    <a
      href={CHANGELOG_URL}
      aria-current={pathname === CHANGELOG_URL ? "page" : undefined}
      >Changelog</a
    >
    <a href={REPO_URL}>GitHub</a>
    <a href={NPM_URL}>npm</a>
  </nav>
  <ThemeSwitcher />
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0.75rem 1rem;
  }

  .logo {
    color: var(--fg);
    font-size: 1.35rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    text-decoration: none;
    --nano-skeleton-inline-ascent: 0.57;
    /**
     * Slightly narrower than the default, so the bars stay within the width
     * of the real word in common UI fonts
     */
    --nano-skeleton-inline-glyph-width: 0.48;
    display: inline-grid;
  }

  .logo > * {
    grid-area: 1 / 1;
  }

  .logo__sizer {
    visibility: hidden;
  }

  .logo__word {
    font-weight: 750;
    color: var(--accent);
  }

  .nav {
    display: flex;
    gap: 1rem;
    margin-inline-start: auto;
    font-size: 0.95rem;
  }

  .nav a {
    color: var(--fg);
    text-decoration: none;
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--accent);
  }

  /**
   * Two rows on narrow screens: the logo, the version and the theme switcher,
   * then the navigation. Slightly smaller, so the first row fits on 360px wide
   * screens.
   */
  @media (max-width: 40rem) {
    .header {
      column-gap: 0.75rem;
    }

    .logo {
      font-size: 1.2rem;
    }

    .nav {
      order: 1;
      flex-basis: 100%;
      margin-inline-start: 0;
    }
  }
</style>
