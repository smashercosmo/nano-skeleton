---
const options = ["auto", "light", "dark"] as const;
---

<fieldset class="theme-switcher">
  <legend class="visually-hidden">Color theme</legend>
  {
    options.map((value) => (
      <label>
        <input
          type="radio"
          name="theme"
          value={value}
          checked={value === "auto"}
          autocomplete="off"
        />
        <span>{value}</span>
      </label>
    ))
  }
</fieldset>
<script is:inline>
  /**
   * Runs right after the switcher is parsed, before the first paint. The theme
   * itself is applied by CSS (:root:has(... :checked)), this only restores
   * and persists the choice. "Auto" follows the system theme through CSS, and
   * a pinned Light or Dark stays pinned when the system theme changes.
   * autocomplete="off" keeps browsers from restoring a stale radio state.
   */
  (() => {
    const KEY = "__color_scheme__";
    const THEMES = new Set(["light", "dark", "auto"]);
    const switcher = document.querySelector(".theme-switcher");

    function save(theme) {
      try {
        localStorage.setItem(KEY, THEMES.has(theme) ? theme : "auto");
      } catch {
        /* Storage is unavailable, the choice lasts until reload */
      }
    }

    function load() {
      try {
        const theme = localStorage.getItem(KEY);
        return theme === "light" || theme === "dark" ? theme : "auto";
      } catch {
        return "auto";
      }
    }

    /** Checks the radio button that matches the theme */
    function select(theme) {
      for (const input of switcher.querySelectorAll("input")) {
        input.checked = input.value === theme;
      }
    }

    /** Updates the stored value when the user switches the theme */
    switcher.addEventListener("change", (event) => save(event.target.value));

    /**
     * The theme was changed in a different tab. The `storage` event only
     * fires in the OTHER tabs, the switcher there has to be updated by hand.
     */
    globalThis.addEventListener("storage", (event) => {
      if (event.key === KEY && THEMES.has(event.newValue)) {
        select(event.newValue);
      }
    });

    /**
     * A page restored from the back/forward cache missed `storage` events
     * while it was frozen, e.g. a theme picked on another page
     */
    globalThis.addEventListener("pageshow", (event) => {
      if (event.persisted) {
        select(load());
      }
    });

    select(load());
  })();
</script>

<style>
  .theme-switcher {
    display: inline-flex;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
  }

  label {
    position: relative;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    cursor: pointer;
    text-transform: capitalize;
  }

  label:has(:checked) {
    background: var(--accent-soft);
    color: var(--accent);
  }

  label:has(:focus-visible) {
    outline: 2px solid var(--accent);
  }

  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 40rem) {
    .theme-switcher {
      margin-inline-start: auto;
    }

    label {
      padding-inline: 0.45rem;
    }
  }
</style>
