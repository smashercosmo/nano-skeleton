---
const options = ["auto", "light", "dark"] as const;
---

<fieldset class="theme-switcher">
  <legend class="visually-hidden">Color theme</legend>
  {
    options.map((value) => (
      <label>
        <input
          type="radio"
          name="theme"
          value={value}
          checked={value === "auto"}
          autocomplete="off"
        />
        <span>{value}</span>
        {
          /**
           * What "auto" currently resolves to: a sun or a moon, and the same
           * in words for screen readers. CSS shows the one matching the
           * system theme, display: none hides the other one from screen
           * readers too
           */
          value === "auto" && (
            <>
              <span class="resolved resolved--light">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <circle cx="8" cy="8" r="3" />
                  <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3" />
                </svg>
                <span class="visually-hidden">(currently light)</span>
              </span>
              <span class="resolved resolved--dark">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M13.5 10A6 6 0 0 1 6 2.5a6 6 0 1 0 7.5 7.5Z" />
                </svg>
                <span class="visually-hidden">(currently dark)</span>
              </span>
            </>
          )
        }
      </label>
    ))
  }
</fieldset>
<script is:inline>
  /**
   * Runs right after the switcher is parsed, before the first paint. The theme
   * itself is applied by CSS (:root:has(... :checked)), this only restores
   * and persists the choice. "Auto" follows the system theme through CSS, and
   * a pinned Light or Dark stays pinned when the system theme changes.
   * autocomplete="off" keeps browsers from restoring a stale radio state.
   */
  (() => {
    const KEY = "__color_scheme__";
    const switcher = document.querySelector(".theme-switcher");

    /** A stored value that isn't a pinned theme means "auto" */
    function normalize(theme) {
      return theme === "light" || theme === "dark" ? theme : "auto";
    }

    /** "Auto" is the default, so it's stored as no value at all */
    function save(theme) {
      try {
        if (normalize(theme) === "auto") {
          localStorage.removeItem(KEY);
        } else {
          localStorage.setItem(KEY, theme);
        }
      } catch {
        /* Storage is unavailable, the choice lasts until reload */
      }
    }

    function load() {
      try {
        return normalize(localStorage.getItem(KEY));
      } catch {
        return "auto";
      }
    }

    /**
     * The browser UI color comes from <meta name="theme-color">, which only
     * follows the system theme through its media queries. A pinned theme gives
     * both of them its own color.
     */
    const themeColors = [
      ...document.querySelectorAll('meta[name="theme-color"][media]'),
    ].map((meta) => ({
      meta,
      scheme: meta.media.includes("dark") ? "dark" : "light",
      color: meta.content,
    }));

    function colorOf(scheme) {
      return themeColors.find((entry) => entry.scheme === scheme)?.color;
    }

    function syncThemeColor(theme) {
      for (const { meta, scheme } of themeColors) {
        meta.content = colorOf(theme === "auto" ? scheme : theme) ?? "";
      }
    }

    /** Checks the radio button that matches the theme */
    function select(theme) {
      for (const input of switcher.querySelectorAll("input")) {
        input.checked = input.value === theme;
      }
      syncThemeColor(theme);
    }

    /**
     * Forced colors mode overrides color-scheme with the user's own palette,
     * so the theme can't be switched there
     */
    const forcedColors = matchMedia("(forced-colors: active)");

    function syncForcedColors() {
      switcher.disabled = forcedColors.matches;
      if (forcedColors.matches) {
        switcher.title =
          "Unavailable in forced colors mode: the page uses your system colors";
      } else {
        switcher.removeAttribute("title");
      }
    }

    /** Updates the stored value when the user switches the theme */
    switcher.addEventListener("change", (event) => {
      save(event.target.value);
      syncThemeColor(normalize(event.target.value));
    });

    forcedColors.addEventListener("change", syncForcedColors);

    /**
     * The theme was changed in a different tab. The `storage` event only
     * fires in the OTHER tabs, the switcher there has to be updated by hand.
     */
    globalThis.addEventListener("storage", (event) => {
      /** No key: the whole storage was cleared. No value: back to "auto" */
      if (event.key === KEY || event.key === null) {
        select(normalize(event.newValue));
      }
    });

    /**
     * A page restored from the back/forward cache missed `storage` events
     * while it was frozen, e.g. a theme picked on another page
     */
    globalThis.addEventListener("pageshow", (event) => {
      if (event.persisted) {
        select(load());
      }
    });

    select(load());
    syncForcedColors();
  })();
</script>

<style>
  .theme-switcher {
    display: inline-flex;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
  }

  label {
    position: relative;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    cursor: pointer;
    text-transform: capitalize;
  }

  label:has(:checked) {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .resolved {
    display: inline-block;
    margin-inline-start: 0.2em;
    vertical-align: -0.1em;
  }

  .resolved svg {
    display: block;
    width: 0.9em;
    height: 0.9em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .resolved--dark svg {
    fill: currentColor;
    stroke: none;
  }

  .resolved--dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .resolved--light {
      display: none;
    }

    .resolved--dark {
      display: inline-block;
    }
  }

  /**
   * Without the icon on the narrowest screens, so the header's first row still
   * fits on 360px wide ones. Screen readers still get the words
   */
  @media (max-width: 25rem) {
    .resolved {
      margin: 0;
    }

    .resolved svg {
      display: none;
    }
  }

  label:has(:focus-visible) {
    outline: 2px solid var(--accent);
  }

  /**
   * Disabled only in forced colors mode, where system colors are kept. Faint
   * diagonal lines behind the labels mark it as unavailable. Forced colors
   * mode drops gradients, so the lines opt out of it and use system colors
   * only, which follow the user's palette.
   */
  .theme-switcher:disabled {
    position: relative;
    isolation: isolate;
  }

  .theme-switcher:disabled::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    forced-color-adjust: none;
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in oklch, GrayText 35%, Canvas) 0 1px,
      transparent 0 5px
    );
  }

  .theme-switcher:disabled label {
    color: GrayText;
    cursor: default;
  }

  /** The checked label's background would cover the lines */
  .theme-switcher:disabled label:has(:checked) {
    background: none;
  }

  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 40rem) {
    .theme-switcher {
      margin-inline-start: auto;
    }

    label {
      padding-inline: 0.45rem;
    }
  }
</style>
