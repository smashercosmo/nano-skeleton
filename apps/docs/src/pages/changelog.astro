---
import Layout from "#components/layout.astro";
// oxlint-disable-next-line import/no-relative-parent-imports -- the changelog lives in the library package
import { compiledContent } from "../../../../packages/nano-skeleton/CHANGELOG.md";

const HEADING = /<h2 id="[^"]*">(?<version>[^<]+)<\/h2>/v;

/**
 * Splits the rendered changelog into versions, so each one gets a readable
 * anchor (#0.7.0 instead of #070) and a badge when it has breaking changes.
 */
const source = await compiledContent();
const html = source
  .split(/(?=<h2)/v)
  .map((chunk) => {
    const version = HEADING.exec(chunk)?.groups?.["version"]?.trim();
    if (version === undefined) {
      return chunk;
    }
    const badge = chunk.includes("BREAKING")
      ? ' <span class="badge badge--danger">Breaking</span>'
      : "";
    const heading = `<h2 id="${version}">${version}${badge}<a class="anchor" href="#${version}" aria-label="Link to ${version}">#</a></h2>`;
    return chunk.replace(HEADING, heading);
  })
  .join("");
---

<Layout
  title="Changelog · nano-skeleton"
  description="Every release of nano-skeleton, with breaking changes marked."
>
  <main class="changelog prose">
    <Fragment set:html={html} />
  </main>
</Layout>

<style>
  .changelog {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
  }

  .changelog :global(h1) {
    font-size: clamp(2rem, 6vw, 2.75rem);
    letter-spacing: -0.035em;
  }

  .changelog :global(h2) {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 1.35rem;
  }

  .changelog :global(h3) {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .changelog :global(li + li) {
    margin-top: 0.5rem;
  }
</style>
