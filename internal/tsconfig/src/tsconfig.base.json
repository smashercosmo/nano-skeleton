{
  "compilerOptions": {
    /**
     * "preserve" assumes,
     * that "moduleResolution" is "bundler"
     */
    "module": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2024",
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "allowJs": true,
    "checkJs": true,

    /**
     * All our apps and libraries are built with bundlers (usually Vite for apps and tsdown for libraries).
     * They handle transpilation, type generation and source maps. Because of that, we don't need settings
     * like "declaration", "declarationMap", "emitDeclarationOnly" and "sourceMap" in our TypeScript configs:
     * TypeScript only checks types here and emits nothing.
     */
    "noEmit": true,
    /**
     * Every project must set its own "tsBuildInfoFile". A relative path here
     * resolves against this file, so all projects would share one build info
     * file and overwrite each other's.
     */
    "incremental": true,

    /**
     * The "strict" setting is "true" by default now, so it isn't set here.
     */
    "allowArbitraryExtensions": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  }
}
