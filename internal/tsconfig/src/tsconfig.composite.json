{
  "compilerOptions": {
    /**
     * Extend this config only in projects that other projects reference, e.g. an app that its tests depend on:
     * { "references": [{ "path": "./tsconfig.json" }], "include": ["./tests"] }
     *
     * A referenced project has to be composite, which makes it generate .d.ts files. Nothing depends on
     * projects like tests or Node scripts, so making them composite would slow down the build for no benefit:
     * leave these three flags out there. A non-composite project can still reference a composite one.
     */
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true
    /**
     * As we use TypeScript just as an analyzer and declaration generator,
     * we specify the output directory just for declarations,
     * and the JS files, transpiled by the bundler, are emitted to the bundler's output directory (usually `dist`).
     *
     * Every `composite` project should have a unique output directory for declarations,
     * which should be added to .gitignore.
     *
     * "outDir": "./unique-declarations-folder-name"
     */
  }
}
