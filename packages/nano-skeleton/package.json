{
  "name": "nano-skeleton",
  "version": "0.9.0",
  "description": "A tiny, framework-agnostic skeleton loader built on Web Components. Turns your real UI into placeholders of the same shape, with no layout shift.",
  "keywords": [
    "skeleton",
    "skeleton-loader",
    "loading",
    "placeholder",
    "shimmer",
    "web-components",
    "custom-elements",
    "framework-agnostic"
  ],
  "homepage": "https://smashercosmo.github.io/nano-skeleton",
  "bugs": {
    "url": "https://github.com/smashercosmo/nano-skeleton/issues"
  },
  "license": "MIT",
  "author": "Vladislav Shkodin <smashercosmo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smashercosmo/nano-skeleton.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#root/*": "./src/*"
  },
  "scripts": {
    "build": "tsdown",
    "lint:types": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@tsdown/css": "catalog:dev",
    "@types/node": "catalog:types",
    "@vitest/browser-playwright": "catalog:test",
    "playwright": "catalog:test",
    "tsdown": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:test"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}
